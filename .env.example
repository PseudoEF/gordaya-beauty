# SQLite database file. Relative paths resolve from the process working
# directory (the project root when using the npm scripts).
# Keep real databases, WAL/SHM files, and backups out of git.
DATABASE_URL="file:./prisma/dev.db"

# Password for the single shared admin account at /admin.
# Change this to a long, unique value before exposing the app.
ADMIN_PASSWORD="change-me-in-production"

# Random string of at least 32 characters used by iron-session to encrypt the
# admin cookie. The app refuses to start if this is missing or too short.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Set to "true" only when the app is served over HTTPS. On plain HTTP
# (localhost or a LAN address) keep it "false", otherwise the browser will
# discard the Secure cookie and admin login will silently fail.
SESSION_COOKIE_SECURE="false"
